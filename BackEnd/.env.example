# Salin file ini menjadi `.env` untuk pengembangan lokal.
# Di FastAPI Cloud, isi variabel yang sama lewat dashboard (tab Environment
# Variables). Jangan commit `.env` — sudah masuk .gitignore.

# --- Wajib ---------------------------------------------------------------
# Atlas M0: +srv, nama database, dan nama cluster yang sesuai dashboard.
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGO_DB_NAME=bantukilat

# Minimal 32 karakter. Kunci ini juga menandatangani URL foto, jadi kalau
# diganti, semua URL media yang sudah beredar langsung tidak valid.
# Buat dengan: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=1440
SERVER_SELECTION_TIMEOUT_MS=5000

# Domain publik aplikasi ini. Dipakai membangun URL absolut foto di response
# (OfferOut.photos, MessageOut.photos). Di cloud WAJIB diisi domain asli,
# misal https://namaproyek.fastapicloud.dev — kalau dibiarkan localhost,
# semua foto di aplikasi tidak bisa dimuat.
PUBLIC_BASE_URL=http://localhost:8000

# --- Media ---------------------------------------------------------------
MEDIA_MAX_INPUT_CHARS=8000000
MEDIA_MAX_BYTES=6000000
MEDIA_URL_TTL_SECONDS=3600
MEDIA_DAILY_VIEW_LIMIT=600
MEDIA_DAILY_UPLOAD_LIMIT=60

# --- Job latar belakang --------------------------------------------------
# Offer lewat expires_at diubah menjadi EXPIRED oleh job di dalam proses API.
# FastAPI Cloud aktif scale-to-zero: saat idle job tidak berjalan, offer mati
# tetap disaring di query sehingga tidak muncul di radar teknisi.
EXPIRE_JOB_ENABLED=true
EXPIRE_CHECK_SECONDS=60

# Pasang index, validator, dan seed kategori saat aplikasi startup. Diperlukan
# di cloud karena tidak ada hook pre-start. Matikan hanya untuk debugging.
SETUP_ON_STARTUP=true

# --- AI ------------------------------------------------------------------
# Provider apa pun dengan protokol OpenAI-compatible (Gemini, OpenAI,
# OpenRouter, Groq). Kalau AI_API_KEY kosong, server memakai pengklasifikasi
# kata kunci lokal (model "local-heuristic") dan tidak memanggil provider.
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
AI_TIMEOUT_SECONDS=30
AI_ALLOW_LOCAL_FALLBACK=true
AI_DAILY_MESSAGE_LIMIT=20
AI_DAILY_ESTIMATE_LIMIT=40
AI_DAILY_PHOTO_MESSAGE_LIMIT=10
AI_HISTORY_MESSAGES=10
# Kuota di-reset tengah malam WIB, bukan 00:00 UTC.
AI_QUOTA_UTC_OFFSET_HOURS=7
